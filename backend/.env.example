# Cadena de conexión a PostgreSQL utilizada por Prisma.
# El contenedor local se levanta con "docker compose up -d piloto-pbd-db"
# (ver README y docs/base-de-datos.md), puerto canónico 5544.
# sslmode=require: cifra la conexión en tránsito (control DES-01); al ser un
# certificado autofirmado de demostración, no valida la cadena de CA (para
# eso se usaría verify-ca/verify-full con un certificado emitido por una CA).
DATABASE_URL="postgresql://piloto:piloto_dev_pw@localhost:5544/piloto_pbd?schema=public&sslmode=require"

# Puerto en el que escucha el servidor Express.
PORT=3000

# Secreto usado para firmar los JWT de autenticación. En producción debe ser
# un valor aleatorio largo y mantenerse fuera del control de versiones.
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Tiempo de expiración de los JWT emitidos (formato admitido por la librería jsonwebtoken).
JWT_EXPIRES_IN="8h"

# Clave AES-256 (32 bytes) para cifrar los campos de salud del modelo
# Consulta (Art. 25 LOPDP, control DES-01). Debe ser un string base64 que
# decodifique a exactamente 32 bytes. Genera una real con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA reutilices el placeholder de abajo como clave real.
CLAVE_CIFRADO="cambiar-por-una-clave-base64-de-32-bytes"

# Secreto SEPARADO del JWT_SECRET de personal: firma los tokens de un solo
# propósito del mecanismo ARCO+ (acceso/rectificación del propio paciente,
# Art. 13/14 LOPDP). Deben ser secretos distintos para que comprometer uno
# no comprometa el otro. Genera uno real con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_ARCO_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-distinto-del-jwt"

# Secreto SEPARADO tanto del JWT_SECRET como del TOKEN_ARCO_SECRET: firma el
# token de un solo propósito y vida corta (20 min) del enlace de
# consentimiento (el QR que RECEPCION entrega en el mostrador, Art. 7
# LOPDP). Genera uno real con el mismo comando de arriba.
TOKEN_CONSENTIMIENTO_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-distinto-de-los-otros-dos"

# Déjala sin definir en local (equivale a "false"): el backend sirve HTTPS
# él mismo con backend/certs/. Solo se pone en "true" en un despliegue real
# donde la plataforma (Render y equivalentes) termina TLS en su borde — ver
# render.yaml y backend/src/services/mantenimiento-privacidad.js.
TLS_TERMINADO_EXTERNAMENTE=false

# Plazos de conservación en días (control DYM-02, ver docs/politica-conservacion.md).
# Valores de DEMOSTRACIÓN — ajustar a la normativa vigente aplicable antes de
# operar en producción (reglamento de historia clínica, LOPDP, etc.).
RETENCION_CITAS_DIAS=730
RETENCION_CONSULTAS_DIAS=3650
